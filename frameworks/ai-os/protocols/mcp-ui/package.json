{
  "name": "@aphrody/mcp-ui",
  "version": "7.1.1-aphrody.1",
  "description": "MCP interactive app client with sandbox readiness and cancellation fixes.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/index.ts --target browser --packages external --outdir dist && tsc --noEmit false --declaration --emitDeclarationOnly --outDir dist/types --rootDir src",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/core": "^2.2.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.25.76 || ^4.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "@happy-dom/global-registrator": "^20.14.5",
    "bun-types": "^1.4.2",
    "jsdom": "22.1.0",
    "@types/jsdom": "^28.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "author": "aphrody-dev <contact@aphrody.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/mcp-ui.git"
  },
  "license": "Apache-2.0",
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "tsconfig.json",
    "!src/**/__tests__/**",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/test-setup.ts",
    "dist",
    "UPSTREAM.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
