    "watch": "bun run src/cli.ts watch",
    "nightly-sync": "bun run src/cli.ts nightly-sync",
    "build": "bun build --compile --minify src/cli.ts --outfile C:/Users/aphro/.local/bin/ai-os.exe",
    "test": "bun test ./tests/ai-os.test.ts",
    "check": "bun check",
    "fmt": "bun fmt"
  },
  "dependencies": {},
  "devDependencies": {}
}
