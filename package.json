{
  "name": "@aphrody/ai-os",
  "version": "1.0.0",
  "description": "Unified Sovereign AI Control Plane, Multi-Protocol Router (OpenAI / MCP / A2A / ACP / Skills) & Real-Time/Nightly Standards Sentinel in pure oven-sh/bun v1.4.4",
  "type": "module",
  "bin": {
    "ai-os": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts serve",
